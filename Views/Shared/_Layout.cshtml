
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@(ViewData["Title"] ?? "Home") - Dazzle Jewels</title>

    <meta name="description"
          content="@(ViewData["Description"] ?? "Discover beautiful jewellery at Dazzle Jewels.")" />

    <meta name="keywords"
          content="Dazzle Jewels, jewellery, earrings, necklaces, rings, bracelets, pendants" />

    <meta name="robots" content="index, follow" />

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Dazzle_Jewels.styles.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <!-- Website Brand -->
                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    Dazzle_Jewels
                </a>

                <!-- Mobile Navbar Button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- Left Side Navigation -->
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Category"
                               asp-action="Index">
                                Categories
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Cart"
                               asp-action="Index">
                                🛒 Cart
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                    </ul>

                    <!-- Right Side Navigation -->
                    <ul class="navbar-nav ms-auto">

                        @if (Context.Session.GetInt32("UserId") == null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Register
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Cart"
                                   asp-action="MyOrders">
                                    My Orders
                                </a>
                            </li>

                            <li class="nav-item">
                                <span class="nav-link text-dark">
                                    Welcome, @Context.Session.GetString("UserName")
                                </span>
                            </li>

                            <!-- Logout Button -->
                            <li class="nav-item">
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="nav-link text-dark border-0 bg-transparent">
                                        Logout
                                    </button>

                                </form>
                            </li>
                        }

                    </ul>

                </div>

            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Dazzle_Jewels -
            <a asp-controller="Home" asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Visitor Tracking Script -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            fetch("/api/Tracking/track", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    pagePath: window.location.pathname
                })
            })
                .then(response => {
                    if (!response.ok) {
                        console.error("Page tracking failed");
                    }
                })
                .catch(error => {
                    console.error("Tracking error:", error);
                });

        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
