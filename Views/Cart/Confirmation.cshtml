
@{
    ViewData["Title"] = "Payment Confirmation";

    bool isSuccess = ViewBag.PaymentStatus == "Success";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-sm p-5 text-center">

                @if (isSuccess)
                {
                    <h1 class="text-success mb-3">✓</h1>

                    <h2>Payment Successful!</h2>

                    <p class="text-muted mt-3">
                        Thank you for shopping with Dazzle Jewels.
                        Your payment has been processed and your order
                        has been placed successfully.
                    </p>
                }
                else
                {
                    <h1 class="text-danger mb-3">✕</h1>

                    <h2>Payment Failed!</h2>

                    <p class="text-muted mt-3">
                        @ViewBag.PaymentMessage
                    </p>
                }

                <hr />

                <h5 class="mb-3">Payment Receipt</h5>

                @if (isSuccess)
                {
                    <p>
                        <strong>Order ID:</strong>
                        #@ViewBag.OrderId
                    </p>
                }

                <p>
                    <strong>Payment Status:</strong>
                    @ViewBag.PaymentStatus
                </p>

                <p>
                    <strong>Payment Method:</strong>
                    @ViewBag.PaymentMethod
                </p>

                <p>
                    <strong>Total Amount:</strong>
                    Rs. @ViewBag.TotalAmount
                </p>

                <p>
                    <strong>Transaction ID:</strong>
                    @ViewBag.TransactionId
                </p>

                <p>
                    <strong>Payment Date:</strong>
                    @ViewBag.PaymentDate
                </p>

                @if (isSuccess)
                {
                    <a asp-controller="Cart"
                       asp-action="MyOrders"
                       class="btn btn-dark mt-3">
                        View My Orders
                    </a>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline-dark mt-2">
                        Continue Shopping
                    </a>
                }
                else
                {
                    <a asp-controller="Cart"
                       asp-action="Payment"
                       class="btn btn-dark mt-3">
                        Try Payment Again
                    </a>

                    <a asp-controller="Cart"
                       asp-action="Index"
                       class="btn btn-outline-dark mt-2">
                        Return to Cart
                    </a>
                }

            </div>
        </div>
    </div>
</div>
