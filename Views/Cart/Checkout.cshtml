
@model List<DazzleJewels.Models.CartItem>

@{
    ViewData["Title"] = "Checkout";
    var user = ViewBag.User as DazzleJewels.Models.User;
    decimal total = Model.Sum(item => item.Price * item.Quantity);
}

<div class="container my-5">
    <h1 class="mb-4">Checkout</h1>

    <div class="row">

        <!-- Customer Information -->
        <div class="col-md-7">
            <div class="card shadow-sm p-4 mb-4">

                <h4 class="mb-3">Delivery Information</h4>

                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input type="text"
                           class="form-control"
                           value="@user?.FullName"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email"
                           class="form-control"
                           value="@user?.Email"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Phone Number</label>
                    <input type="text"
                           class="form-control"
                           value="@user?.PhoneNumber"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Delivery Address</label>
                    <textarea class="form-control"
                              rows="3"
                              readonly>@user?.Address</textarea>
                </div>

                <p class="text-muted">
                    To change your delivery details, update your account information.
                </p>

            </div>
        </div>

        <!-- Order Summary -->
        <div class="col-md-5">
            <div class="card shadow-sm p-4">

                <h4 class="mb-3">Order Summary</h4>

                @foreach (var item in Model)
                {
                    <div class="d-flex justify-content-between mb-3">

                        <div>
                            <strong>@item.ProductName</strong>
                            <p class="text-muted mb-0">
                                Quantity: @item.Quantity
                            </p>
                        </div>

                        <span>
                            Rs. @((item.Price * item.Quantity).ToString("N0"))
                        </span>

                    </div>
                }

                <hr />

                <div class="d-flex justify-content-between">
                    <h5>Total Amount</h5>
                    <h5>Rs. @total.ToString("N0")</h5>
                </div>

               <form asp-controller="Cart"
      asp-action="PlaceOrder"
      method="post">

    <button type="submit" class="btn btn-dark w-100 mt-4">
        Place Order
    </button>

</form>

            </div>
        </div>

    </div>
</div>
