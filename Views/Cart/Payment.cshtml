
@model List<DazzleJewels.Models.CartItem>

@{
    ViewData["Title"] = "Dummy Payment Gateway";
    var user = ViewBag.User as DazzleJewels.Models.User;
    decimal total = (decimal)ViewBag.TotalAmount;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-sm p-4">
                <div class="text-center mb-4">
                    <h2>Secure Payment</h2>
                    <p class="text-muted">
                        Dazzle Jewels Dummy Payment Gateway
                    </p>
                    <span class="badge bg-warning text-dark">
                        Test / Demo Mode
                    </span>
                </div>

                <hr />

                <h5 class="mb-3">Payment Details</h5>

                <p>
                    <strong>Customer:</strong>
                    @user?.FullName
                </p>

                <p>
                    <strong>Email:</strong>
                    @user?.Email
                </p>

                <div class="bg-light rounded p-3 mb-4">
                    <div class="d-flex justify-content-between">
                        <h5>Total to Pay</h5>
                        <h5>Rs. @total.ToString("N2")</h5>
                    </div>
                </div>

                <form asp-controller="Cart"
                      asp-action="ProcessPayment"
                      method="post">

                    @Html.AntiForgeryToken()

                    <h5 class="mb-3">Select Payment Method</h5>

                    <div class="form-check mb-2">
                        <input class="form-check-input"
                               type="radio"
                               name="paymentMethod"
                               value="eSewa (Demo)"
                               id="esewa"
                               checked />

                        <label class="form-check-label" for="esewa">
                            eSewa (Demo)
                        </label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input"
                               type="radio"
                               name="paymentMethod"
                               value="Khalti (Demo)"
                               id="khalti" />

                        <label class="form-check-label" for="khalti">
                            Khalti (Demo)
                        </label>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input"
                               type="radio"
                               name="paymentMethod"
                               value="Card (Demo)"
                               id="card" />

                        <label class="form-check-label" for="card">
                            Debit / Credit Card (Demo)
                        </label>
                    </div>

                    <button type="submit"
                            name="paymentResult"
                            value="success"
                            class="btn btn-success w-100 mb-3">
                        Simulate Successful Payment
                    </button>

                    <button type="submit"
                            name="paymentResult"
                            value="failure"
                            class="btn btn-danger w-100">
                        Simulate Failed Payment
                    </button>

                </form>

                <p class="text-muted text-center mt-4 mb-0">
                    This is a dummy payment gateway for demonstration.
                    No real money will be charged.
                </p>

            </div>
        </div>
    </div>
</div>
